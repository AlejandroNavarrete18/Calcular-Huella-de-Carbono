# Copia este archivo como server/.env y completa los valores. NUNCA subas el .env a Git.

# ── Servidor ──
PORT=3001
# Páginas autorizadas a llamar a la API (separadas por comas)
ALLOWED_ORIGINS=http://localhost:5173
# Número de proxies de confianza si el servidor está detrás de uno (Nginx, etc.). Vacío = sin proxy
TRUST_PROXY=
# true = el servidor también sirve client/dist (requiere `npm run build`)
SERVE_CLIENT=false

# ── Base de datos MySQL (esquema en database/schema.sql) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=huella_carbono

# ── Correo ──
# Llave de 64 caracteres hexadecimales para cifrar las contraseñas de las cuentas. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_SECRET_KEY=
MAIL_FROM_NAME=Calculadora de Huella de Carbono
# Opcional: correo al que responderán las personas
MAIL_REPLY_TO=
# true = no envía nada y guarda el correo en server/.dry-run/ (no necesita base de datos ni llave)
MAIL_DRY_RUN=false

# ── Límites de envío ──
LIMIT_EMAILS_PER_IP_PER_HOUR=5
LIMIT_EMAILS_PER_RECIPIENT_PER_HOUR=3