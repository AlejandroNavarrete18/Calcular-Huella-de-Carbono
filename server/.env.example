# ─────────────────────────────────────────────────────────────────────────────
#  Configuración del servidor de correo
#
#  1) Copia este archivo:   cp .env.example .env      (Windows: copy .env.example .env)
#  2) Rellena los valores de abajo.
#  3) NUNCA subas el archivo .env a GitHub ni lo compartas: contiene tu contraseña.
#
#  Guía completa paso a paso: docs/configuracion-correo.md
# ─────────────────────────────────────────────────────────────────────────────

# --- Cuenta de Gmail que ENVÍA los correos ---
# Tu dirección completa de Gmail. Ej: huella.pruebas@gmail.com
GMAIL_USER=tu-correo@gmail.com

# Contraseña de APLICACIÓN de 16 letras (NO es tu contraseña normal de Gmail).
# Se puede pegar con o sin espacios. Cómo crearla: docs/configuracion-correo.md
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Nombre que verá quien reciba el correo como remitente
MAIL_FROM_NAME=Calculadora de Huella de Carbono

# --- Servidor ---
PORT=3001

# Páginas web autorizadas a usar esta API (separadas por coma, sin "/" al final).
# En desarrollo la web corre en http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Límites anti-abuso (opcional) ---
LIMIT_EMAILS_PER_IP_PER_HOUR=5
LIMIT_EMAILS_PER_RECIPIENT_PER_HOUR=3

# --- Modo de prueba sin Gmail (opcional) ---
# Con true NO se envía nada: el correo se guarda como HTML en server/.dry-run/ para verlo en el navegador.
MAIL_DRY_RUN=false

# --- Producción (opcional) ---
# SERVE_CLIENT=true     El servidor también sirve la web compilada (client/dist). Ver README.
# TRUST_PROXY=1         Solo si está detrás de un proxy (Render, Railway, Nginx...)
